# LLM Gateway — copy to .env and edit
LLM_DEFAULT_PROVIDER=ollama          # ollama | lmstudio | llamacpp | openai
LLM_DEFAULT_MODEL=                   # empty = auto-detect first available model
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1

# Cloud OpenAI-compatible provider (OpenAI / DeepSeek / Together / vLLM ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Data provider default: yahoo | nse
DATA_DEFAULT_PROVIDER=yahoo

# Database (defaults to local SQLite; use Postgres DSN in production)
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/stockos

# Security
# JWT_SECRET=change-me
