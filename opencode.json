{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/agents/working-agreement.md",
    "docs/architecture/context-policy.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "python -m pytest*": "allow",
      "python -m compileall*": "allow",
      "git push*": "ask"
    },
    "edit": "ask",
    "external_directory": "deny"
  },
  "mcp": {
    "git-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ]
    },
    "codebase_memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "codebase-memory-mcp"
      ],
      "enabled": false,
      "timeout": 10000
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "//": "Generated by scripts/sync_clients.py \u2014 do not edit by hand. Source: skills/ agents/."
}
